---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/figures.css';
import { WRITING_MODE } from '../../site';

export async function getStaticPaths() {
  if (WRITING_MODE !== 'full') return [];
  const posts = await getCollection('writing');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.description} canonical={d.originalUrl} image={d.hero}>
  <article class="post">
    <header class="wrap head">
      <h1>{d.title}</h1>
      <p class="byline">{d.author}</p>
      <p class="meta">
        {fmt(d.published)}{d.updated && <> · updated {d.updated}</>}{d.tags.length > 0 && <> · {d.tags.join(', ')}</>}
      </p>
      <p class="origin">
        Originally published on <a href={d.originalUrl}>{d.publisher}'s blog ↗</a>
      </p>
    </header>
    {d.hero && <img class="hero" src={d.hero} alt="" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .head { max-width: calc(var(--text) + 32px); padding-top: 56px; }
  .head h1 { font-size: clamp(34px, 5vw, 56px); margin: 0 0 18px; }
  .byline { margin: 0; font-weight: 600; }
  .head .meta { margin: 4px 0 0; }
  .origin { margin: 18px 0 0; padding: 10px 14px; background: var(--band); border-left: 3px solid var(--accent);
            font-size: 15px; color: var(--muted); }
  .hero { display: block; width: min(100% - 32px, 1100px); margin: 40px auto; border-radius: 3px; }

  .prose { max-width: calc(var(--text) + 32px); margin: 0 auto; padding-inline: 16px; font-size: 18px; line-height: 1.7; }
  .prose :global(h2) { font-size: 32px; margin: 2em 0 .5em; }
  .prose :global(h3) { font-size: 24px; margin: 1.6em 0 .4em; }
  .prose :global(img), .prose :global(svg) { max-width: 100%; height: auto; display: block; margin: 1.5em auto; border-radius: 3px; }
  .prose :global(figure) { margin: 2em 0; }
  .prose :global(figcaption) { font-size: 14px; color: var(--muted); text-align: center; }
  .prose :global(blockquote) { margin: 1.6em 0; padding: 0 0 0 22px; border-left: 3px solid var(--accent);
                               font: italic 22px/1.5 var(--serif); }
  .prose :global(code) { font: 0.88em var(--mono); background: var(--band); padding: .1em .35em; border-radius: 3px; }
  .prose :global(pre) { background: var(--band); padding: 16px; overflow-x: auto; border-radius: 3px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; margin: 1.5em 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(aside) { background: var(--band); padding: 18px 22px; margin: 1.8em 0; border-radius: 3px; font-size: 16px; }
  .prose :global(details) { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 12px 0; margin: 1em 0; }
  .prose :global(summary) { cursor: pointer; font-weight: 600; }
</style>
