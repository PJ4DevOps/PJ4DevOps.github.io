---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/figures.css';
import '../../styles/article.css';
import { WRITING_MODE } from '../../site';

export async function getStaticPaths() {
  if (WRITING_MODE !== 'full') return [];
  const posts = await getCollection('writing');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} description={d.description} canonical={d.originalUrl} image={d.hero}>
  <article class="post">
    <header class="wrap head">
      <h1>{d.title}</h1>
      <p class="byline">{d.author}</p>
      <p class="meta">
        {fmt(d.published)}{d.updated && <> · updated {d.updated}</>}{d.tags.length > 0 && <> · {d.tags.join(', ')}</>}
      </p>
      <p class="origin">
        Originally published on <a href={d.originalUrl}>{d.publisher}'s blog ↗</a>
      </p>
    </header>
    {d.hero && <img class="hero" src={d.hero} alt="" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .origin { margin: 18px 0 0; padding: 10px 14px; background: var(--band); border-left: 3px solid var(--accent);
            font-size: 15px; color: var(--muted); }
</style>
